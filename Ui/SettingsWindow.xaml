<Window x:Class="LaunchHere.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchHere Settings"
        Width="780" Height="860" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LaunchHere;component/Ui/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,24">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0"
                           Text="Apps open on the monitor where you clicked to launch them." />

                <!-- ============================================================ Apps -->
                <TextBlock Text="Apps" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <RadioButton x:Name="BlacklistRadio" Content="Move every app except the ones listed below" GroupName="Mode" />
                        <RadioButton x:Name="WhitelistRadio" Content="Move only the apps listed below" GroupName="Mode" Margin="0,4,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <ListView x:Name="AppsList" Height="200" BorderThickness="0" SelectionMode="Extended"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="App" Width="200">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Matches" Width="250" DisplayMemberBinding="{Binding Matches}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="EmptyListText" Style="{StaticResource Secondary}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Text="No apps in the list" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="170">
                                <Button x:Name="AddRunningButton" Content="Add running app..." HorizontalAlignment="Stretch" />
                                <Button x:Name="BrowseButton" Content="Browse for app..." HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                                <Button x:Name="RemoveButton" Content="Remove" HorizontalAlignment="Stretch" Margin="0,8,0,0" IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddNameBox" VerticalContentAlignment="Center" />
                            <TextBlock Text="Or type an exe name, e.g. chrome.exe" FontSize="13"
                                       Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="AddNameButton" Grid.Column="1" Content="Add" Width="170" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                   Text="An exe name matches every copy of that app. A full path matches only that copy." />
                    </StackPanel>
                </Border>

                <!-- ============================================================ Behaviour -->
                <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Taskbar, jump lists and Start menu" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Move apps launched from a monitor's taskbar onto that monitor" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <CheckBox x:Name="WatchTaskbarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Desktop shortcuts" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Move apps opened from a desktop icon onto that monitor" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <CheckBox x:Name="WatchDesktopToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Bring open windows to the clicked taskbar" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Text="Clicking an app's icon or window preview on another monitor's taskbar moves that window there. Needs Windows' taskbar setting &quot;Show my taskbar apps on: All taskbars&quot;." />
                        </StackPanel>
                        <CheckBox x:Name="MoveOpenToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Run LaunchHere when you sign in" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ============================================================ Updates -->
                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock x:Name="VersionText" Text="LaunchHere" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Secondary}" Text="Check GitHub for a newer version." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ReleaseNotesButton" Content="Release notes" Visibility="Collapsed" Margin="0,0,8,0" />
                                <Button x:Name="UpdateNowButton" Content="Update now" Visibility="Collapsed" Margin="0,0,8,0"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Maximum="1" />
                    </StackPanel>
                </Border>

                <!-- ============================================================ Advanced -->
                <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="4,2">
                    <Expander x:Name="AdvancedExpander" Header="Timings and logging" Padding="12,4,12,12">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,8,16,8">
                                <TextBlock Text="Wait for the app's window (ms)" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="How long after a click a new window still counts. Slow-starting apps need more." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <TextBox x:Name="ArmTimeoutBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" />

                            <StackPanel Grid.Row="1" Margin="0,8,16,8">
                                <TextBlock Text="Also move the app's next windows for (ms)" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Covers a splash screen followed by the main window." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <TextBox x:Name="GraceBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" />

                            <StackPanel Grid.Row="2" Margin="0,8,16,8">
                                <TextBlock Text="Switch detection window (ms)" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="A click that brings an open window to the front within this time is a switch, not a launch." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <TextBox x:Name="CancelBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" />

                            <StackPanel Grid.Row="3" Margin="0,8,16,8">
                                <TextBlock Text="Height shrink for windows too wide for the monitor" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="0 keeps the height, 1 shrinks it in proportion to the width." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <TextBox x:Name="ShrinkBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" />

                            <StackPanel Grid.Row="4" Margin="0,8,16,8">
                                <TextBlock Text="Detailed log" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Write every window LaunchHere looks at to launch-here.log." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <CheckBox x:Name="DebugLogToggle" Grid.Row="4" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" />

                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <Hyperlink x:Name="ConfigLink">Open config.json (all settings, including re-check timings)</Hyperlink>
                            </TextBlock>
                        </Grid>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ footer -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="32,16"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="OK" MinWidth="110" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
                <Button x:Name="ApplyButton" Content="Apply" MinWidth="110" Margin="8,0,0,0" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
