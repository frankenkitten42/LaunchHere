<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF for the settings window (Windows 11 Fluent theme); the tray icon stays WinForms. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Physical pixel coordinates everywhere; required for mixed-DPI monitor setups. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>LaunchHere</AssemblyName>
    <RootNamespace>LaunchHere</RootNamespace>
    <Version>0.2.1-beta</Version>
    <!-- Keep the git commit hash out of the product version ("0.1.0-beta", not "0.1.0-beta+<hash>"). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- WPF0001: ThemeMode (the Fluent theme switch) is marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Test builds: `dotnet publish -c Release -p:TestHooks=true -o DIR` adds the arm-test and update-now switches
       and the LAUNCHHERE_UPDATE_FEED / LAUNCHHERE_UPDATE_PUBKEY overrides. Never ship one. -->
  <PropertyGroup Condition="'$(TestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_HOOKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF share type names (Button, MessageBox...): import WinForms per file instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- `dotnet publish -c Release` => one standalone LaunchHere.exe (no .NET install needed). -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Uncompressed on purpose: Windows then maps the bundled code straight from the exe instead of unpacking a
         private copy into memory (measured 2026-11-26: idle 50 -> 12 MB committed, after Settings 132 -> 55 MB).
         Costs download size: ~165 MB instead of ~72 MB. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>dist\</PublishDir>
  </PropertyGroup>

</Project>
